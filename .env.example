# Database (Neon Postgres in production; local dev uses docker-compose)
# Local dev: postgres://weather:weather@localhost:5432/weather
DATABASE_URL=postgres://user:password@host/dbname

# Server
PORT=3000

# Admin bootstrap (used once to seed the initial admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# External data source for the generator (no API key required)
WEATHER_API_BASE=https://api.open-meteo.com/v1
