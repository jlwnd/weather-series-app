meta {
  name: Create measurement
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/measurements
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "value": 12.5,
    "timestamp": "2026-01-10T10:00:00Z"
  }
}

assert {
  res.status: eq 201
  res.headers.location: isDefined
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("measurementId", res.getBody().id);
  }
}
