meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin12345"
  }
}

assert {
  res.status: eq 200
  res.body.tokenType: eq Bearer
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("token", res.getBody().accessToken);
  }
}
